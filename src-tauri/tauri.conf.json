{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoClicker",
  "version": "3.0.0",
  "identifier": "com.mealiyeye.autoclicker",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AutoClicker",
        "width": 640,
        "height": 900,
        "minWidth": 540,
        "minHeight": 660,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "center": true,
        "shadow": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": false
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [],
    "copyright": "MIT License",
    "category": "Utility",
    "shortDescription": "Windows Auto Clicker",
    "longDescription": "A modern, DPI-aware auto clicker for Windows with multi-point clicking, configurable intervals, profiles and global hotkeys.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "En-US"],
        "displayLanguageSelector": true
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
